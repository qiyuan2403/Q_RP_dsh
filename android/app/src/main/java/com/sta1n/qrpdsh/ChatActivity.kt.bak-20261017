class ChatActivity : ComponentActivity() {
    override fun onCreate(savedInstanceState: Bundle?) {
        super.onCreate(savedInstanceState)
        val home = filesDir.absolutePath
        setContent { DswTheme(dark = false) { DshApp(home) } }
    }
}

data class SessionRow(val id: String, val title: String, val blank: Boolean, val running: Boolean, val updatedAt: Long)
data class ChatItem(val seq: Long, val kind: String, val text: String, val name: String = "", val error: Boolean = false)

private fun parseSessions(raw: String): List<SessionRow> = runCatching {
    val a = JSONArray(raw)
    List(a.length()) { i ->
        val o = a.getJSONObject(i)
        SessionRow(o.optString("id"), o.optString("title"), o.optBoolean("blank"), o.optBoolean("running"), o.optLong("updatedAt"))
    }
}.getOrDefault(emptyList())

private fun parseReplay(raw: String): Triple<String, List<ChatItem>, String?> = runCatching {
    val o = JSONObject(raw)
    val id = o.optString("id")
    val error = o.optString("error").takeIf { it.isNotEmpty() }
    val events = o.optJSONArray("events") ?: JSONArray()
    val out = ArrayList<ChatItem>()
    for (i in 0 until events.length()) {
        val e = events.getJSONObject(i)
        val type = e.optString("type")
        val d = e.optJSONObject("data") ?: JSONObject()
        val item = when (type) {
            "user/message" -> ChatItem(e.optLong("seq"), "user", d.optString("text"))
            "assistant/message" -> ChatItem(e.optLong("seq"), "assistant", d.optString("text"))
            "tool/call" -> ChatItem(e.optLong("seq"), "tool", d.optString("name"), d.optString("name"))
            "tool/result" -> ChatItem(e.optLong("seq"), "tool-result", d.optString("output", d.optString("error")), d.optString("name"), d.has("error"))
            else -> null
        }
        if (item != null && (item.text.isNotBlank() || item.kind == "tool")) out += item
    }
    Triple(id, out, error)
}.getOrElse { Triple("", emptyList(), it.message ?: "无法读取会话") }

private const val SETTINGS_NAME = "connection"
private const val KEY_BASE_URL = "baseUrl"
private const val KEY_API_KEY = "apiKey"
private const val KEY_MODEL = "model"

private data class ConnectionSettings(val baseUrl: String, val apiKey: String, val model: String)

private fun loadSettings(context: Context): ConnectionSettings {
    val prefs = context.getSharedPreferences(SETTINGS_NAME, Context.MODE_PRIVATE)
    return ConnectionSettings(
        prefs.getString(KEY_BASE_URL, "https://api.deepseek.com/v1") ?: "",
        prefs.getString(KEY_API_KEY, "") ?: "",
        prefs.getString(KEY_MODEL, "deepseek-chat") ?: "deepseek-chat",
    )
}

private fun saveSettings(context: Context, settings: ConnectionSettings) {
    context.getSharedPreferences(SETTINGS_NAME, Context.MODE_PRIVATE).edit()
        .putString(KEY_BASE_URL, settings.baseUrl.trim())
        .putString(KEY_API_KEY, settings.apiKey)
        .putString(KEY_MODEL, settings.model.trim())
        .apply()
}

@androidx.compose.runtime.Composable
private fun DshApp(home: String) {
    val context = LocalContext.current
    val activity = context as ChatActivity
    val dsw = LocalDsw.current
    val scope = rememberCoroutineScope()
    val drawer = rememberDrawerState(DrawerValue.Closed)
    var settings by remember { mutableStateOf(loadSettings(context)) }
    var showSettings by remember { mutableStateOf(false) }
    var sessions by remember { mutableStateOf(emptyList<SessionRow>()) }
    var selected by remember { mutableStateOf<SessionRow?>(null) }
    var items by remember { mutableStateOf(emptyList<ChatItem>()) }
    var input by remember { mutableStateOf("") }
    var busy by remember { mutableStateOf(false) }
    var status by remember { mutableStateOf<String?>(null) }

    fun openRow(row: SessionRow) {
        selected = row
        scope.launch(Dispatchers.IO) {
            val replay = parseReplay(Native.openSessionId(home, row.id))
            withContext(Dispatchers.Main) { items = replay.second; status = replay.third }
        }
    }
    fun refresh() {
        scope.launch(Dispatchers.IO) {
            val rows = parseSessions(Native.listSessions(home))
            val replay = if (selected == null) parseReplay(Native.openSession(home)) else null
            withContext(Dispatchers.Main) {
                sessions = rows
                if (replay != null) {
                    selected = rows.firstOrNull { it.id == replay.first }
                        ?: SessionRow(replay.first, "", true, false, 0L)
                    items = replay.second
                    status = replay.third
                }
            }
        }
    }
    fun create() {
        scope.launch(Dispatchers.IO) {
            val replay = parseReplay(Native.createSession(home))
            withContext(Dispatchers.Main) {
                if (replay.first.isNotEmpty()) {
                    val row = SessionRow(replay.first, "", true, false, System.currentTimeMillis())
                    selected = row
                    sessions = listOf(row) + sessions
                    items = replay.second
                    status = replay.third
                } else status = replay.third
                scope.launch { drawer.close() }
            }
        }
    }
    fun send() {
        val task = input.trim()
        val id = selected?.id ?: return
        if (task.isEmpty() || busy) return
        if (settings.baseUrl.isBlank() || settings.model.isBlank()) {
            status = "请先配置 API 地址和模型"
            showSettings = true
            return
        }
        input = ""
        busy = true
        status = null
        scope.launch(Dispatchers.IO) {
            val result = runCatching {
                val nodePath = runCatching { NodeRuntime.materialize(activity) }.getOrNull()
                val response = JSONObject(Native.runTurn(task, home, home, settings.baseUrl, settings.apiKey, settings.model, nodePath, id))
                response to parseReplay(Native.openSessionId(home, id))
            }
            withContext(Dispatchers.Main) {
                result.fold(
                    onSuccess = { (response, replay) ->
                        items = replay.second
                        status = replay.third ?: response.optString("error").takeIf { it.isNotBlank() }
                        busy = false
                        sessions = parseSessions(Native.listSessions(home))
                    },
                    onFailure = { error -> status = error.message ?: "请求失败"; busy = false },
                )
            }
        }
    }
    LaunchedEffect(Unit) { refresh() }

    if (showSettings) {
        ConnectionDialog(settings, dsw, onDismiss = { showSettings = false }) { next ->
            saveSettings(context, next)
            settings = next
            showSettings = false
            status = null
        }
    }

    ModalNavigationDrawer(drawerState = drawer, drawerContent = {
        ModalDrawerSheet(drawerContainerColor = dsw.sidebarFill) {
            Row(Modifier.fillMaxWidth().padding(16.dp), verticalAlignment = Alignment.CenterVertically) {
                Text("会话", fontSize = 18.sp, fontWeight = FontWeight.SemiBold, color = dsw.textPrimary)
                Spacer(Modifier.weight(1f))
                IconButton(onClick = { showSettings = true }) { Icon(Icons.Default.Settings, "设置", tint = dsw.textPrimary) }
                IconButton(onClick = { create() }) { Icon(Icons.Default.Add, "新建", tint = dsw.textPrimary) }
            }
            LazyColumn(contentPadding = PaddingValues(horizontal = 8.dp, vertical = 4.dp)) {
                items(sessions, key = { it.id }) { row ->
                    val active = selected?.id == row.id
                    Row(Modifier.fillMaxWidth().height(32.dp).background(if (active) dsw.interactiveHover else Color.Transparent, RoundedCornerShape(8.dp)).clickable { openRow(row); scope.launch { drawer.close() } }.padding(horizontal = 8.dp), verticalAlignment = Alignment.CenterVertically) {
                        if (row.running) Box(Modifier.size(7.dp).background(Color(0xFF22C55E), RoundedCornerShape(4.dp))) else Spacer(Modifier.size(7.dp))
                        Spacer(Modifier.width(8.dp)); Text(if (row.blank) "新会话" else row.title.ifBlank { "未命名" }, maxLines = 1, color = dsw.textPrimary, fontSize = 13.sp)
                    }
                }
            }
        }
    }) {
        Surface(Modifier.fillMaxSize(), color = dsw.bgBase) {
            Column(Modifier.fillMaxSize().imePadding()) {
                Row(Modifier.fillMaxWidth().height(56.dp).padding(horizontal = 8.dp), verticalAlignment = Alignment.CenterVertically) {
                    IconButton(onClick = { scope.launch { drawer.open() } }) { Icon(Icons.Default.Menu, "会话", tint = dsw.textPrimary) }
                    Text(selected?.title?.ifBlank { "新会话" } ?: "新会话", color = dsw.textPrimary, fontSize = 16.sp, fontWeight = FontWeight.Medium)
                    Spacer(Modifier.weight(1f))
                    IconButton(onClick = { showSettings = true }) { Icon(Icons.Default.Settings, "设置", tint = dsw.textPrimary) }
                    if (status != null) Text(status!!, color = dsw.textSecondary, fontSize = 12.sp)
                }
                val listState = rememberLazyListState()
                LazyColumn(Modifier.weight(1f).fillMaxWidth(), state = listState, contentPadding = PaddingValues(16.dp, 16.dp, 16.dp, 24.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
                    items(items, key = { it.seq }) { item -> MessageRow(item, dsw) }
                    if (busy) item { Row(verticalAlignment = Alignment.CenterVertically) { CircularProgressIndicator(Modifier.size(16.dp), strokeWidth = 2.dp, color = dsw.brandPrimary); Spacer(Modifier.width(8.dp)); Text("正在思考", color = dsw.textSecondary, fontSize = 13.sp) } }
                }
                Composer(input, { input = it }, ::send, busy, dsw)
            }
        }
    }
}

@androidx.compose.runtime.Composable
private fun ConnectionDialog(initial: ConnectionSettings, dsw: Dsw, onDismiss: () -> Unit, onSave: (ConnectionSettings) -> Unit) {
    var baseUrl by remember(initial) { mutableStateOf(initial.baseUrl) }
    var apiKey by remember(initial) { mutableStateOf(initial.apiKey) }
    var model by remember(initial) { mutableStateOf(initial.model) }
    AlertDialog(
        onDismissRequest = onDismiss,
        title = { Text("模型连接", color = dsw.textPrimary) },
        text = {
            Column(verticalArrangement = Arrangement.spacedBy(8.dp)) {
                OutlinedTextField(baseUrl, { baseUrl = it }, label = { Text("API 地址") }, singleLine = true)
                OutlinedTextField(apiKey, { apiKey = it }, label = { Text("API 密钥") }, singleLine = true)
                OutlinedTextField(model, { model = it }, label = { Text("模型") }, singleLine = true)
            }
        },
        confirmButton = { TextButton(onClick = { onSave(ConnectionSettings(baseUrl, apiKey, model)) }) { Text("保存") } },
        dismissButton = { TextButton(onClick = onDismiss) { Text("取消") } },
    )
}

    fun openRow(row: SessionRow) {
        selected = row
        scope.launch(Dispatchers.IO) {
            val replay = parseReplay(Native.openSessionId(home, row.id))
            withContext(Dispatchers.Main) {
                items = replay.second
                status = replay.third
            }
        }
    }
    fun refresh() {
        scope.launch(Dispatchers.IO) {
            val rows = parseSessions(Native.listSessions(home))
            val replay = if (selected == null) parseReplay(Native.openSession(home)) else null
            withContext(Dispatchers.Main) {
                sessions = rows
                if (replay != null) {
                    val row = rows.firstOrNull { it.id == replay.first }
                        ?: SessionRow(replay.first, "", true, false, 0L)
                    selected = row
                    items = replay.second
                    status = replay.third
                }
            }
        }
    }
    fun create() {
        scope.launch(Dispatchers.IO) {
            val replay = parseReplay(Native.createSession(home))
            withContext(Dispatchers.Main) {
                if (replay.first.isNotEmpty()) {
                    val row = SessionRow(replay.first, "", true, false, System.currentTimeMillis())
                    selected = row
                    sessions = listOf(row) + sessions
                    items = replay.second
                    status = replay.third
                } else {
                    status = replay.third
                }
                scope.launch { drawer.close() }
            }
        }
    }
    fun send() {
        val task = input.trim()
        val id = selected?.id ?: return
        if (task.isEmpty() || busy) return
        input = ""
        busy = true
        status = null
        scope.launch(Dispatchers.IO) {
            val result = runCatching {
                val nodePath = runCatching { NodeRuntime.materialize(activity) }.getOrNull()
                val response = JSONObject(Native.runTurn(task, home, home, "", "", "deepseek-chat", nodePath, id))
                val replay = parseReplay(Native.openSessionId(home, id))
                response to replay
            }
            withContext(Dispatchers.Main) {
                result.fold(
                    onSuccess = { (response, replay) ->
                        items = replay.second
                        status = when {
                            replay.third != null -> replay.third
                            !response.optBoolean("ok") -> response.optString("error", "请求失败")
                            else -> null
                        }
                        busy = false
                        sessions = parseSessions(Native.listSessions(home))
                    },
                    onFailure = { error ->
                        status = error.message ?: "请求失败"
                        busy = false
                    },
                )
            }
        }
    }
    LaunchedEffect(Unit) { refresh() }

    ModalNavigationDrawer(drawerState = drawer, drawerContent = {
        ModalDrawerSheet(drawerContainerColor = dsw.sidebarFill) {
            Row(Modifier.fillMaxWidth().padding(16.dp), verticalAlignment = Alignment.CenterVertically) {
                Text("会话", fontSize = 18.sp, fontWeight = FontWeight.SemiBold, color = dsw.textPrimary)
                Spacer(Modifier.weight(1f)); IconButton(onClick = { create() }) { Icon(Icons.Default.Add, "新建", tint = dsw.textPrimary) }
            }
            LazyColumn(contentPadding = PaddingValues(horizontal = 8.dp, vertical = 4.dp)) {
                items(sessions, key = { it.id }) { row ->
                    val active = selected?.id == row.id
                    Row(Modifier.fillMaxWidth().height(32.dp).background(if (active) dsw.interactiveHover else Color.Transparent, RoundedCornerShape(8.dp)).clickable { openRow(row); scope.launch { drawer.close() } }.padding(horizontal = 8.dp), verticalAlignment = Alignment.CenterVertically) {
                        if (row.running) Box(Modifier.size(7.dp).background(Color(0xFF22C55E), RoundedCornerShape(4.dp))) else Spacer(Modifier.size(7.dp))
                        Spacer(Modifier.width(8.dp)); Text(if (row.blank) "新会话" else row.title.ifBlank { "未命名" }, maxLines = 1, color = dsw.textPrimary, fontSize = 13.sp)
                    }
                }
            }
        }
    }) {
        Surface(Modifier.fillMaxSize(), color = dsw.bgBase) {
            Column(Modifier.fillMaxSize().imePadding()) {
                Row(Modifier.fillMaxWidth().height(56.dp).padding(horizontal = 8.dp), verticalAlignment = Alignment.CenterVertically) {
                    IconButton(onClick = { scope.launch { drawer.open() } }) { Icon(Icons.Default.Menu, "会话", tint = dsw.textPrimary) }
                    Text(selected?.title?.ifBlank { "新会话" } ?: "新会话", color = dsw.textPrimary, fontSize = 16.sp, fontWeight = FontWeight.Medium)
                    Spacer(Modifier.weight(1f)); if (status != null) Text(status!!, color = dsw.textSecondary, fontSize = 12.sp)
                }
                val listState = rememberLazyListState()
                LazyColumn(Modifier.weight(1f).fillMaxWidth(), state = listState, contentPadding = PaddingValues(16.dp, 16.dp, 16.dp, 24.dp), verticalArrangement = Arrangement.spacedBy(12.dp)) {
                    items(items, key = { it.seq }) { item -> MessageRow(item, dsw) }
                    if (busy) item { Row(verticalAlignment = Alignment.CenterVertically) { CircularProgressIndicator(Modifier.size(16.dp), strokeWidth = 2.dp, color = dsw.brandPrimary); Spacer(Modifier.width(8.dp)); Text("正在思考", color = dsw.textSecondary, fontSize = 13.sp) } }
                }
                Composer(input, { input = it }, ::send, busy, dsw)
            }
        }
    }
}


@androidx.compose.runtime.Composable
private fun MessageRow(item: ChatItem, dsw: Dsw) {
    val user = item.kind == "user"
    Column(Modifier.fillMaxWidth(), horizontalAlignment = if (user) Alignment.End else Alignment.Start) {
        if (item.kind == "tool" || item.kind == "tool-result") {
            Row(Modifier.fillMaxWidth().padding(start = 8.dp), verticalAlignment = Alignment.CenterVertically) { Box(Modifier.width(2.dp).height(28.dp).background(dsw.borderL2)); Spacer(Modifier.width(10.dp)); Text(if (item.kind == "tool") "工具 · ${item.name}" else "${item.name} · ${item.text}", color = if (item.error) dsw.danger else dsw.textSecondary, fontSize = 12.sp) }
        } else Surface(color = if (user) dsw.bubble else Color.Transparent, shape = RoundedCornerShape(20.dp)) { Text(item.text, Modifier.padding(horizontal = 16.dp, vertical = 10.dp), color = dsw.textPrimary, fontSize = 14.sp) }
    }
}
@Composable
private fun Composer(value: String, onValue: (String) -> Unit, send: () -> Unit, busy: Boolean, dsw: Dsw) {
    Row(Modifier.fillMaxWidth().padding(horizontal = 16.dp, vertical = 12.dp), verticalAlignment = Alignment.Bottom) {
        OutlinedTextField(
            value = value,
            onValueChange = onValue,
            modifier = Modifier.weight(1f),
            placeholder = { Text("输入消息", color = dsw.textTertiary) },
            shape = RoundedCornerShape(28.dp),
            maxLines = 5,
        )
        Spacer(Modifier.width(8.dp))
        IconButton(onClick = send, enabled = !busy && value.isNotBlank()) {
            Icon(Icons.Default.Menu, "发送", tint = dsw.brandPrimary)
        }
    }
}

